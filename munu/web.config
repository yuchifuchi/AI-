<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
   web.config ── munu の tacit2/ フォルダに置く（IIS/classic ASP 用）
  ============================================================
   役割：
   1) 原本ファイル（PDF/Word/Excel）の一括投入で本文サイズが大きくなるため、
      ASP のリクエスト上限を 8MB に引き上げる（既定は約200KBで不足）。
   2) 機微内容の保護ヘッダ（MIME推測禁止・クリックジャッキング抑止・リファラ抑止）。
   3) HTTPS化“後”に有効化する設定（セッションCookieのSecure化・HSTS）はコメントで用意。

   ⚠️ このファイルは秘密情報を含みません（コミット可）。
   ⚠️ 下の keepSessionIdSecure と HSTS は「HTTPS化が完了してから」有効化すること。
      HTTPのまま有効化するとセッションCookieが送られず、ログインできなくなります。
  ============================================================
-->
<configuration>
  <system.webServer>

    <asp>
      <!-- 一括投入の原本ファイル（base64）を受けられるように 8MB へ（既定は約200KB） -->
      <limits maxRequestEntityAllowed="8388608" />

      <!-- ▼ HTTPS化が完了したら、次の1行のコメントを外す（セッションCookieをSecureに） ▼ -->
      <!-- <session keepSessionIdSecure="true" /> -->
    </asp>

    <!-- IIS 側の受信ボディ上限も併せて引き上げ（8MB） -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="no-referrer" />
        <!-- ▼ HTTPS化が完了したら、次の1行のコメントを外す（常時HTTPS強制・HSTS） ▼ -->
        <!-- <add name="Strict-Transport-Security" value="max-age=31536000" /> -->
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
